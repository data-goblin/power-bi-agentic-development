{
  "description": "Windows only. After PowerShell that saves model changes, runs te validate --local against the open Power BI Desktop model and reports measures without metadata. Says at session start when it is off. Toggle in config.yaml.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/desktop-hooks.sh\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/desktop-hooks.sh\" post",
            "timeout": 120,
            "if": "Bash(*SaveChanges*)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/desktop-hooks.sh\" post",
            "timeout": 120,
            "if": "Bash(* -File *.ps1*)"
          }
        ]
      }
    ]
  }
}
